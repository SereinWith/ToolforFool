# 应用配置示例，复制为 .env 后按需修改
APP_NAME=ToolForFool
# 生产环境建议设为 false，开发调试设为 true
DEBUG=false
DATABASE_URL=sqlite:///./data/app.db
CRAWLER_DELAY=1.0

# 跨域来源，逗号分隔；前后端同域部署时无需修改
# 例：CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=*

# 录入古籍时自动繁体转简体（true=开启，false=保留原文）
AUTO_SIMPLIFY=true

# ===== AI 大模型配置 =====
# provider: doubao（豆包/火山引擎）或 openai（OpenAI 兼容接口）
AI_PROVIDER=doubao
AI_API_KEY=
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_MODEL=doubao-lite-4k
# 多模态视觉模型（用于 AI 看图识字）
AI_VISION_MODEL=doubao-1.5-vision-lite-250315
AI_TIMEOUT=30

# ===== OCR 配置 =====
# provider: auto（自动优先级：vision → baidu → paddle）
#           或固定为 vision / baidu / paddle
OCR_PROVIDER=auto
OCR_TIMEOUT=60

# 视觉大模型方案：复用上面的 AI_API_KEY / AI_BASE_URL / AI_VISION_MODEL，无需额外配置

# 百度云 OCR 方案（可选，免费额度足够个人使用）
# 在 https://console.bce.baidu.com/ai/#/ai/ocr/overview/index 创建应用获取 AK/SK
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
