# 应用配置示例，复制为 .env 后按需修改
APP_NAME=古籍文献阅读辅助工具
# 生产环境建议设为 false，开发调试设为 true
DEBUG=false
DATABASE_URL=sqlite:///./data/app.db
CRAWLER_DELAY=1.0

# 跨域来源，逗号分隔；前后端同域部署时无需修改
# 例：CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=*

# ===== AI 大模型配置（阶段三）=====
# provider: doubao（豆包/火山引擎）或 openai（OpenAI 兼容接口）
AI_PROVIDER=doubao
AI_API_KEY=
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_MODEL=doubao-lite-4k
AI_TIMEOUT=30

# ===== OCR 配置（阶段三）=====
# provider: paddle（本地 PaddleOCR）或 cloud（云 API，预留）
OCR_PROVIDER=paddle
OCR_API_KEY=
